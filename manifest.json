{
  "manifest_version": 3,
  "name": "RAM Manager",
  "version": "1.1.0",
  "description": "Suspend idle tabs to free memory. Lightweight, fast, and themeable.",
  "minimum_chrome_version": "109",
  "author": "RAM Manager",
  "homepage_url": "https://github.com/jd-paul/ram-manager",
  "permissions": [
    "tabs",
    "storage",
    "alarms",
    "contextMenus",
    "scripting"
  ],
  "optional_host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "options_ui": {
    "page": "settings/settings.html",
    "open_in_tab": true
  },
  "commands": {
    "suspend-active-tab": {
      "suggested_key": {
        "default": "Alt+Shift+X"
      },
      "description": "Suspend the currently active tab"
    }
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  }
}
